<ui:FluentWindow x:Class="PopClip.App.UI.ClipboardHistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 x:ClassModifier="internal"
                 Title="ClipAura 剪贴板历史"
                 Width="400"
                 Height="460"
                 MinWidth="320"
                 MinHeight="280"
                 Left="-32000"
                 Top="-32000"
                 Topmost="True"
                 ShowInTaskbar="False"
                 WindowStartupLocation="Manual"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="OnWindowPreviewKeyDown"
                 Background="{DynamicResource Settings.Window.Background}"
                 Foreground="{DynamicResource Settings.Foreground}"
                 FontFamily="{DynamicResource Settings.FontFamily}">
    <Grid Background="{DynamicResource Settings.Window.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="剪贴板历史"
                     Style="{StaticResource Settings.CompactTitleBar}"
                     ShowMaximize="False"
                     ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="History24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Tab 切换：文本（默认）/ 图片。右侧 Pin 把浮层钉在最前，失焦不关，方便连贴。 -->
        <Grid Grid.Row="1" Margin="14,8,14,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabTextRadio"
                             GroupName="HistoryTab"
                             Content="文本"
                             IsChecked="True"
                             Margin="0,0,8,0"
                             Checked="OnTabChanged" />
                <RadioButton x:Name="TabImageRadio"
                             GroupName="HistoryTab"
                             Content="图片"
                             Checked="OnTabChanged" />
            </StackPanel>
            <ui:Button x:Name="PinButton"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Appearance="Secondary"
                       Padding="8,2"
                       Click="OnPinClicked"
                       ToolTip="钉在最前，点击条目即可连续粘贴">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin24" FontSize="14" />
                    <TextBlock x:Name="PinLabel"
                               Text="钉住"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <ui:TextBox Grid.Row="2"
                    x:Name="SearchBox"
                    Margin="14,8,14,8"
                    PlaceholderText="搜索 · 1-9 直选 · Esc 关闭"
                    Icon="{ui:SymbolIcon Search24}"
                    TextChanged="OnSearchChanged"
                    KeyDown="OnSearchKeyDown" />

        <Border Grid.Row="3"
                Margin="14,0,14,8"
                Background="{DynamicResource Settings.Card.Background}"
                BorderBrush="{DynamicResource Settings.Stroke}"
                BorderThickness="1"
                CornerRadius="{StaticResource Settings.Radius.Md}">
            <Grid>
            <ListBox x:Name="HistoryList"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemDoubleClick"
                     KeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding IndexLabel}"
                                           Grid.Column="0"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Settings.Muted}" />
                                <TextBlock Text="{Binding Preview}"
                                           Grid.Column="1"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="13"
                                           Foreground="{DynamicResource Settings.Foreground}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding TimeLabel}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource Settings.Muted}" />
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding MetaLabel}"
                                       FontSize="11"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource Settings.Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox x:Name="ImageList"
                     Background="Transparent"
                     BorderThickness="0"
                     Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnImageDoubleClick"
                     KeyDown="OnImageListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding IndexLabel}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Settings.Muted}" />
                            <Border Grid.Column="1"
                                    Width="60" Height="60"
                                    Background="#22000000"
                                    CornerRadius="4">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Header}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Settings.Foreground}" />
                                <TextBlock Text="{Binding MetaLabel}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource Settings.Muted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TimeLabel}"
                                       FontSize="11"
                                       VerticalAlignment="Top"
                                       Margin="8,2,0,0"
                                       Foreground="{DynamicResource Settings.Muted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="{DynamicResource Settings.Stroke}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="HintText"
                           VerticalAlignment="Center"
                           FontSize="11.5"
                           Foreground="{DynamicResource Settings.SubtleForeground}"
                           Text="Enter 粘贴 · Shift+Enter 留下 · 1-9 直选 · Ctrl+Enter 复制" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               Content="复制"
                               Margin="0,0,6,0"
                               Click="OnCopyClicked" />
                    <ui:Button Appearance="Primary"
                               Content="粘贴"
                               Click="OnPasteClicked" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
