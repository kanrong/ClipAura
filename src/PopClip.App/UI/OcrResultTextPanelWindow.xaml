<Window x:Class="PopClip.App.UI.OcrResultTextPanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="OCR 识别文本"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <Window.Resources>
        <Style x:Key="PanelIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层 6px 留白给阴影 -->
    <Grid Margin="6">
        <Border x:Name="PanelBorder"
                Background="{DynamicResource ToolbarToastBackground}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.42" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部标题条：左侧标题 + 右侧操作图标按钮，整条作为拖动响应区 -->
                <Border x:Name="HeaderBorder"
                        Grid.Row="0"
                        Padding="10,6,6,6"
                        Cursor="SizeAll"
                        Background="Transparent"
                        BorderBrush="{DynamicResource ToolbarSeparator}"
                        BorderThickness="0,0,0,1"
                        ToolTip="按住标题栏可拖动到屏幕任意位置">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterialDesign Kind="DescriptionRound"
                                                              Width="14" Height="14"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"
                                                              Foreground="{DynamicResource ToolbarForeground}"
                                                              Opacity="0.85" />
                            <TextBlock x:Name="HeaderTitle"
                                       Text="识别文本"
                                       Foreground="{DynamicResource ToolbarForeground}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderMeta"
                                       Foreground="{DynamicResource ToolbarForeground}"
                                       FontSize="11"
                                       Opacity="0.65"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource PanelIconButtonStyle}"
                                    Click="OnCopyAll"
                                    ToolTip="复制全部识别文本">
                                <iconPacks:PackIconMaterialDesign Kind="ContentCopyRound" Width="13" Height="13" />
                            </Button>
                            <Button Style="{StaticResource PanelIconButtonStyle}"
                                    Click="OnClose"
                                    ToolTip="关闭文本面板">
                                <iconPacks:PackIconMaterialDesign Kind="CloseRound" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 主体：只读 TextBox，整段文字可滚动、可全选、可复制；
                     选中后右键也能弹出系统默认上下文菜单 -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,8,4,10">
                    <TextBox x:Name="ContentBox"
                             IsReadOnly="True"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource ToolbarForeground}"
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             SnapsToDevicePixels="True" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
