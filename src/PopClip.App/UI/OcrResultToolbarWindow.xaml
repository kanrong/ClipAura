<Window x:Class="PopClip.App.UI.OcrResultToolbarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="OCR 工具条"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <Window.Resources>
        <!-- 图标按钮模板：内层 IconHost 容纳 PackIconMaterialDesign，
             仅在视觉上呈现图标 + 可选小角标，避免文字干扰阅读源图 -->
        <Style x:Key="OcrToolIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态文本胶囊：仅当 host 主动赋值 status 时短暂出现，平时折叠让工具条更轻 -->
        <Style x:Key="OcrStatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ToolbarAccentSoft}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Opacity" Value="0.95" />
        </Style>

        <Style x:Key="OcrToolbarSepStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,5" />
            <Setter Property="Fill" Value="{DynamicResource ToolbarSeparator}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Window.Resources>

    <!-- 外层 6px 留白给普通阴影；两行 Grid 让 toast 自然从工具栏下方弹出 -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- ToolbarBorder 本身就是拖动响应区：除按钮以外的任意位置按下都触发 DragMove。
             这样不再需要专门的 grip ⋮⋮ 占据左侧空间，整体观感更紧凑、操作更直接 -->
        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Padding="6,4"
                Background="{DynamicResource ToolbarToastBackground}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.22" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 状态胶囊：默认折叠；host 在"已选 N 段 / 翻译中..."等真状态来时显示。
                     去掉了原有的"点击 / 拖框 / Ctrl+A 全选"引导文字，避免对老用户的视觉污染 -->
                <Border x:Name="StatusPill"
                        Style="{StaticResource OcrStatusPillStyle}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="StatusText"
                               Foreground="{DynamicResource ToolbarForeground}"
                               FontSize="11.5"
                               VerticalAlignment="Center" />
                </Border>

                <!-- 复制组：复制全部 / 复制选中 -->
                <Button x:Name="CopyAllButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnCopyAll"
                        ToolTip="复制全部识别文本 · 取布局还原后的整段文字">
                    <iconPacks:PackIconMaterialDesign Kind="ContentCopyRound" Width="16" Height="16" />
                </Button>
                <Button x:Name="CopySelectedButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnCopySelected"
                        ToolTip="复制已选段落 (Ctrl+C) · 仅当工具栏左侧显示已选数量时可用">
                    <iconPacks:PackIconMaterialDesign Kind="LibraryAddCheckRound" Width="16" Height="16" />
                </Button>
                <Button Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnCopyScreenshot"
                        ToolTip="复制原截图图片到剪贴板">
                    <iconPacks:PackIconMaterialDesign Kind="ImageRound" Width="16" Height="16" />
                </Button>

                <Rectangle Style="{StaticResource OcrToolbarSepStyle}" />

                <!-- 原文贴图切换：在结果图对应文本框位置显示 / 隐藏 OCR 原文 -->
                <Button x:Name="ToggleInlineTextButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnToggleInlineText"
                        ToolTip="显示识别原文贴图 · 在结果图对应文本框位置显示 OCR 原文">
                    <iconPacks:PackIconMaterialDesign x:Name="ToggleInlineTextIcon"
                                                     Kind="DescriptionRound"
                                                     Width="16" Height="16" />
                </Button>

                <Rectangle x:Name="TranslateSep"
                           Style="{StaticResource OcrToolbarSepStyle}"
                           Visibility="Collapsed" />

                <!-- 启用 AI 引导按钮：AI 未启用时占用翻译组位置，点击直达设置 AI 页 -->
                <Button x:Name="EnableAiButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnOpenAiSettings"
                        Visibility="Collapsed"
                        ToolTip="启用 AI 翻译 · 点击跳到设置面板配置 Provider / API Key">
                    <iconPacks:PackIconMaterialDesign Kind="SmartToyRound" Width="16" Height="16" />
                </Button>

                <!-- 翻译切换按钮：AI 启用时显示，未启用时整组隐藏让位给上方"启用 AI"引导按钮。
                     单按钮承载"翻译显示 / 原文显示"两态切换；图标 + ToolTip 随状态同步刷新。
                     翻译范围自适应：有选中段译选中段，否则译全部，与"复制选中/全部"按钮同款思路 -->
                <Button x:Name="TranslateToggleButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnToggleTranslation"
                        Visibility="Collapsed"
                        ToolTip="翻译并显示译文 · 有选中段译选中段，否则译全部">
                    <iconPacks:PackIconMaterialDesign x:Name="TranslateToggleIcon"
                                                     Kind="TranslateRound"
                                                     Width="16" Height="16" />
                </Button>

                <Rectangle Style="{StaticResource OcrToolbarSepStyle}" />

                <!-- 文本面板切换：打开 / 关闭右侧识别文本面板 -->
                <Button x:Name="ToggleTextPanelButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnToggleTextPanel"
                        ToolTip="切换识别文本侧边面板 · 显示整段文字方便整体阅读 / 复制">
                    <iconPacks:PackIconMaterialDesign x:Name="ToggleTextPanelIcon"
                                                     Kind="ChromeReaderModeRound"
                                                     Width="16" Height="16" />
                </Button>

                <!-- Quick 输出：保持原本功能，仅替换图标 -->
                <Button Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnSwitchToQuick"
                        ToolTip="切换 Quick 输出 · 一次性按 Quick 模式输出本次结果（不修改设置）">
                    <iconPacks:PackIconMaterialDesign Kind="BoltRound" Width="16" Height="16" />
                </Button>

                <!-- 切到截图：与截图工具栏的"切到 OCR"按钮形成对偶入口，
                     点击关闭 OCR 结果窗、用同一张截图打开截图预览窗（保留复制/保存/再次 OCR 能力） -->
                <Button x:Name="SwitchToScreenshotButton"
                        Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnSwitchToScreenshot"
                        ToolTip="切换到截图预览（在原截图上做复制 / 保存 / 再识别）">
                    <iconPacks:PackIconMaterialDesign Kind="PhotoCameraRound" Width="16" Height="16" />
                </Button>

                <Rectangle Style="{StaticResource OcrToolbarSepStyle}" />

                <!-- 关闭按钮：用 Material Close 图标 -->
                <Button Style="{StaticResource OcrToolIconButtonStyle}"
                        Click="OnCloseClicked"
                        ToolTip="关闭 (Esc)">
                    <iconPacks:PackIconMaterialDesign Kind="CloseRound" Width="16" Height="16" />
                </Button>
            </StackPanel>
        </Border>

        <!-- 工具栏自己的轻量 toast：默认 Collapsed 时 Grid.Row 高度归零，不影响布局；
             有反馈消息时短暂弹出在工具栏正下方，让"复制 / 翻译"等动作的反馈贴近用户视线 -->
        <Border x:Name="LocalToastBorder"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Padding="10,4"
                Background="{DynamicResource ToolbarToastBackground}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.20" Color="Black" />
            </Border.Effect>
            <TextBlock x:Name="LocalToastText"
                       Foreground="{DynamicResource ToolbarForeground}"
                       FontSize="11.5" />
        </Border>
    </Grid>
</Window>
