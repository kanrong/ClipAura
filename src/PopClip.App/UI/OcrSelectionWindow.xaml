<Window x:Class="PopClip.App.UI.OcrSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        Cursor="Cross">
    <Canvas x:Name="RootCanvas" Background="Transparent">
        <!-- 选区四周的半透明黑色蒙层（上/下/左/右四块组合），让选区中心保持完全透明 -->
        <Rectangle x:Name="MaskTop"    Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="MaskBottom" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="MaskLeft"   Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="MaskRight"  Fill="#99000000" IsHitTestVisible="False" />

        <!-- 1px 蓝色主线，在暗色蒙层、浅色页面和彩色背景上都能稳定区分选区边界。
             选区内部完全透明，确保用户看到的是屏幕原始内容，不被色调干扰 -->
        <Rectangle x:Name="SelectionRectOuter"
                   Stroke="Transparent"
                   StrokeThickness="0"
                   Fill="Transparent"
                   IsHitTestVisible="False" />
        <Rectangle x:Name="SelectionRect"
                   Stroke="#FF2EA8FF"
                   StrokeThickness="2"
                   Fill="Transparent"
                   IsHitTestVisible="False" />

        <!-- 实时尺寸胶囊：默认折叠，用户开始拖框且选区面积非 0 时才显示。
             去掉了"拖动鼠标选择 OCR 区域"这种引导文案，让蒙层视觉更克制 -->
        <Border x:Name="HintBorder"
                Background="#E6101820"
                BorderBrush="#FF2EA8FF"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="HintText"
                       Foreground="#F8FAFC"
                       FontSize="12" />
        </Border>
    </Canvas>
</Window>
