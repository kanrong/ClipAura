<Window x:Class="PopClip.App.UI.PinnedScreenshotWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="钉图"
        FontFamily="{DynamicResource ToolbarFontFamily}">
    <!-- 钉图窗口：把截图固定在桌面顶部参考。
         与 ScreenshotPreviewWindow 的差别：
         - 不抢焦点（ShowActivated=False + WS_EX_NOACTIVATE | WS_EX_TOOLWINDOW）；
         - 默认 Topmost，但右键菜单可关；
         - 双击图像触发 OCR；右键菜单提供完整动作；
         - Ctrl+滚轮缩放图像，10% ~ 400%；
         - 透明度 4 档（100/80/60/40），鼠标悬停时强制 100%；
         - 多窗口共存，关一个不影响其他。 -->
    <Window.Resources>
        <Style x:Key="PinnedMenuItemStyle" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{DynamicResource ToolbarFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <!-- 外层 4 DIP 阴影边距与 ScreenshotPreviewWindow 对齐 -->
    <Grid Margin="4">
        <Border x:Name="Frame"
                BorderBrush="{DynamicResource ToolbarAccentSoft}"
                BorderThickness="2"
                Background="Transparent"
                HorizontalAlignment="Center"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.28" Color="Black" />
            </Border.Effect>
            <Grid x:Name="ImageContainer" ClipToBounds="True">
                <!-- Stretch=Fill：缩放后 PreviewImage 控件大小由 Width/Height 显式指定，
                     让 ImageScalingMode=NearestNeighbor 在所有缩放档位都保持像素清晰；
                     默认 1:1 时 Width=PixelWidth/96 * dpi，与 ScreenshotPreviewWindow 同款 -->
                <Image x:Name="PreviewImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True">
                    <Image.ContextMenu>
                        <ContextMenu x:Name="PreviewContextMenu">
                            <MenuItem x:Name="MenuCopy" Header="复制图片 (Ctrl+C)" Click="OnMenuCopyClicked" Style="{StaticResource PinnedMenuItemStyle}" />
                            <MenuItem x:Name="MenuSave" Header="保存为 PNG…" Click="OnMenuSaveClicked" Style="{StaticResource PinnedMenuItemStyle}" />
                            <MenuItem x:Name="MenuOcr" Header="切换到 OCR 识别" Click="OnMenuOcrClicked" Style="{StaticResource PinnedMenuItemStyle}" />
                            <Separator />
                            <MenuItem x:Name="MenuOpacity" Header="透明度" Style="{StaticResource PinnedMenuItemStyle}">
                                <MenuItem x:Name="MenuOpacity100" Header="100%" IsCheckable="True" Click="OnOpacityClicked" Tag="1.0" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuOpacity80"  Header="80%"  IsCheckable="True" Click="OnOpacityClicked" Tag="0.8" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuOpacity60"  Header="60%"  IsCheckable="True" Click="OnOpacityClicked" Tag="0.6" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuOpacity40"  Header="40%"  IsCheckable="True" Click="OnOpacityClicked" Tag="0.4" Style="{StaticResource PinnedMenuItemStyle}" />
                            </MenuItem>
                            <MenuItem x:Name="MenuTopmost" Header="始终置顶" IsCheckable="True" IsChecked="True" Click="OnTopmostClicked" Style="{StaticResource PinnedMenuItemStyle}" />
                            <MenuItem x:Name="MenuScale" Header="缩放" Style="{StaticResource PinnedMenuItemStyle}">
                                <MenuItem x:Name="MenuScale50"   Header="50%"   IsCheckable="True" Click="OnScaleClicked" Tag="0.5" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuScale100"  Header="100%"  IsCheckable="True" Click="OnScaleClicked" Tag="1.0" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuScale200"  Header="200%"  IsCheckable="True" Click="OnScaleClicked" Tag="2.0" Style="{StaticResource PinnedMenuItemStyle}" />
                                <MenuItem x:Name="MenuScale400"  Header="400%"  IsCheckable="True" Click="OnScaleClicked" Tag="4.0" Style="{StaticResource PinnedMenuItemStyle}" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="MenuClose" Header="关闭 (Shift+Esc)" Click="OnMenuCloseClicked" Style="{StaticResource PinnedMenuItemStyle}" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
            </Grid>
        </Border>
    </Grid>
</Window>
