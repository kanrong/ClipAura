<Window x:Class="PopClip.App.UI.ScreenshotCountdownWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="延时截图倒计时"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <!-- 圆形大数字 + ESC 取消按钮。整个窗口固定 140x140 DIP，
         倒计时归零自动关闭并触发截图选区蒙层 -->
    <Grid Width="140" Height="140">
        <!-- 半透明深色背景圆，让数字不被桌面上其他亮色干扰 -->
        <Ellipse Fill="#E0202020"
                 StrokeThickness="2"
                 Stroke="#FFFFFFFF" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
            <TextBlock x:Name="CountdownText"
                       Foreground="White"
                       FontSize="48"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Text="3" />
            <TextBlock Foreground="#FFCCCCCC"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       Text="ESC 取消 · 点击外部不关闭" />
        </StackPanel>
    </Grid>
</Window>
