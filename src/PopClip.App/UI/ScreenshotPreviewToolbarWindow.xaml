<Window x:Class="PopClip.App.UI.ScreenshotPreviewToolbarWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="截图工具条"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <Window.Resources>
        <!-- 视觉规格严格沿用 OcrResultToolbarWindow 的 OcrToolIconButtonStyle，
             两个工具条作为同一套设计语言出现，避免主图切换时风格抖动 -->
        <Style x:Key="ScreenshotToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScreenshotToolbarSepStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,5" />
            <Setter Property="Fill" Value="{DynamicResource ToolbarSeparator}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Window.Resources>

    <!-- 外层 6px Margin 给阴影留绘制空间
         Row 0: 主面板（一个 Border 内含两行 StackPanel，看起来是一个面板）
         Row 1: 复制 / 保存反馈用的 LocalToast 子面板（独立于主面板，仅短暂展示） -->
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 主面板：一个 Border + StackPanel Vertical 两行布局
             第一行（始终可见）：尺寸胶囊 + 绘制工具组 + 展开按钮 | OCR / 重新截图 | 复制 / 保存 / 钉图 | 关闭
             第二行（点展开按钮才展开）：直线 / 颜色 / 粗细 / Undo / Redo / 清空 / 完成

             分组语义：把"编辑相关"全部归到左侧（绘制工具 + 展开），中间是"切换类操作"（OCR / 重新截图），
             右侧才是"输出类操作"（复制 / 保存 / 钉图）。这样视觉上从左到右是"修改 → 转换 → 导出"，
             用户做完一个动作链顺手就能找到下一步入口 -->
        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Padding="6,4"
                Background="{DynamicResource ToolbarToastBackground}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.22" Color="Black" />
            </Border.Effect>
            <StackPanel x:Name="ToolbarRoot" Orientation="Vertical">
                <!-- 第一行：尺寸胶囊（弱化）+ 绘制工具组 + 展开 | OCR / 重截 | 复制 / 保存 / 钉图 | 关闭 -->
                <StackPanel x:Name="PrimaryRow" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 尺寸胶囊：视觉降权 —— 去掉强调底色、降低不透明度 + 字号缩小，让它不抢按钮焦点
                         背景留一个非常浅的描边而非 AccentSoft 实心填充，只在用户主动看时才进入视野 -->
                    <Border Padding="7,2"
                            Margin="2,0,6,0"
                            BorderBrush="{DynamicResource ToolbarSeparator}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Opacity="0.55">
                        <TextBlock x:Name="DimensionText"
                                   Foreground="{DynamicResource ToolbarForeground}"
                                   FontSize="10.5"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- ===== 左侧编辑组：高频绘制工具，点任一按钮自动进入标注模式
                         双击矩形 / 椭圆切换"实心 / 空心" ===== -->
                    <Button x:Name="ToolRectButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Rectangle"
                            ToolTip="矩形（双击切换实心 / 空心，按住 Shift 强制正方形）">
                        <iconPacks:PackIconMaterialDesign Kind="CropSquareRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ToolEllipseButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Ellipse"
                            ToolTip="椭圆（双击切换实心 / 空心，按住 Shift 强制正圆）">
                        <iconPacks:PackIconMaterialDesign Kind="PanoramaFishEyeRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ToolArrowButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Arrow"
                            ToolTip="箭头">
                        <iconPacks:PackIconMaterialDesign Kind="ArrowRightAltRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ToolFreehandButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Freehand"
                            ToolTip="画笔">
                        <iconPacks:PackIconMaterialDesign Kind="BrushRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ToolTextButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Text"
                            ToolTip="文字（点位置后输入文字 / 点击文字外完成 / 再次点击文字可继续编辑）">
                        <iconPacks:PackIconMaterialDesign Kind="TitleRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ToolMosaicButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Mosaic"
                            ToolTip="马赛克（像素化）">
                        <iconPacks:PackIconMaterialDesign Kind="GrainRound" Width="16" Height="16" />
                    </Button>
                    <!-- 实心遮挡按钮：用 WPF 原生 Rectangle 直接绘制实心方形，与"圆形 LensRound"区分语义 -->
                    <Button x:Name="ToolMaskButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Mask"
                            ToolTip="实心遮挡（纯色填充）">
                        <Rectangle Width="14" Height="14" Fill="{DynamicResource ToolbarForeground}" />
                    </Button>
                    <!-- 展开高级选项按钮：紧跟绘制工具末尾，与"编辑组"自然成对 ——
                         展开后第二行出现 直线 / 颜色 / 粗细 / Undo / Redo / 清空 / 完成 -->
                    <Button x:Name="EditAnnotationButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnEditAnnotationClicked"
                            ToolTip="展开高级选项（直线 / 颜色 / 粗细 / Undo / Redo / 清空）">
                        <iconPacks:PackIconMaterialDesign Kind="TuneRound" Width="16" Height="16" />
                    </Button>

                    <Rectangle Style="{StaticResource ScreenshotToolbarSepStyle}" />

                    <!-- ===== 中间切换组：OCR / 重新截图 ===== -->
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnOcrClicked"
                            ToolTip="切换到 OCR 识别（识别当前截图，O）">
                        <iconPacks:PackIconMaterialDesign Kind="DescriptionRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ReshootButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnReshootClicked"
                            ToolTip="重新截图 · 关闭本预览并重新框选新的截图区域">
                        <iconPacks:PackIconMaterialDesign Kind="CropFreeRound" Width="16" Height="16" />
                    </Button>

                    <Rectangle Style="{StaticResource ScreenshotToolbarSepStyle}" />

                    <!-- ===== 右侧输出组：复制 / 保存 / 钉图 ===== -->
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnCopyClicked"
                            ToolTip="复制图片到剪贴板 (Ctrl+C)">
                        <iconPacks:PackIconMaterialDesign Kind="ContentCopyRound" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnSaveClicked"
                            ToolTip="保存图片为 PNG (Ctrl+S)">
                        <iconPacks:PackIconMaterialDesign Kind="SaveAltRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="PinButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnPinClicked"
                            ToolTip="钉到桌面 · 把截图（含已绘制标注）固定为桌面置顶参考层">
                        <iconPacks:PackIconMaterialDesign Kind="PushPinRound" Width="16" Height="16" />
                    </Button>

                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnCloseClicked"
                            ToolTip="关闭 (Esc)">
                        <iconPacks:PackIconMaterialDesign Kind="CloseRound" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- 第二行：高级选项。默认折叠，点"编辑"按钮展开
                     与第一行共用同一个 Border 背景 / 边框 / 阴影，视觉上是面板下半部分而非独立浮窗
                     Margin Top=6 给两行之间留一个轻微垂直间距，但仍属于同一个面板 -->
                <StackPanel x:Name="AdvancedRow"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,6,0,0"
                            Visibility="Collapsed">
                    <!-- 直线：使用频次低于矩形 / 椭圆 / 箭头 / 涂鸦，从主行收纳到高级面板，给主行让位 -->
                    <Button x:Name="ToolLineButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnToolButtonClicked"
                            Tag="Line"
                            ToolTip="直线">
                        <iconPacks:PackIconMaterialDesign Kind="HorizontalRuleRound" Width="16" Height="16" />
                    </Button>

                    <Rectangle Style="{StaticResource ScreenshotToolbarSepStyle}" />

                    <!-- 颜色组：6 个色卡 -->
                    <Button x:Name="ColorRedButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FFE53935" ToolTip="红色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FFE53935" />
                    </Button>
                    <Button x:Name="ColorYellowButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FFFDD835" ToolTip="黄色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FFFDD835" />
                    </Button>
                    <Button x:Name="ColorBlueButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FF1E88E5" ToolTip="蓝色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FF1E88E5" />
                    </Button>
                    <Button x:Name="ColorGreenButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FF43A047" ToolTip="绿色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FF43A047" />
                    </Button>
                    <Button x:Name="ColorBlackButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FF000000" ToolTip="黑色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FF000000" />
                    </Button>
                    <Button x:Name="ColorWhiteButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnColorClicked" Tag="#FFFFFFFF" ToolTip="白色" Padding="2">
                        <Border Width="20" Height="20" CornerRadius="3" Background="#FFFFFFFF" BorderBrush="#FF888888" BorderThickness="1" />
                    </Button>

                    <Rectangle Style="{StaticResource ScreenshotToolbarSepStyle}" />

                    <!-- 粗细组：细 / 中 / 粗 -->
                    <Button x:Name="ThinButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnThicknessClicked" Tag="1" ToolTip="细 1px">
                        <Rectangle Width="16" Height="2" Fill="{DynamicResource ToolbarForeground}" />
                    </Button>
                    <Button x:Name="MidButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnThicknessClicked" Tag="2" ToolTip="中 2px">
                        <Rectangle Width="16" Height="3" Fill="{DynamicResource ToolbarForeground}" />
                    </Button>
                    <Button x:Name="ThickButton" Style="{StaticResource ScreenshotToolButtonStyle}" Click="OnThicknessClicked" Tag="4" ToolTip="粗 4px">
                        <Rectangle Width="16" Height="5" Fill="{DynamicResource ToolbarForeground}" />
                    </Button>

                    <Rectangle Style="{StaticResource ScreenshotToolbarSepStyle}" />

                    <!-- Undo / Redo / 清空 / 完成（取消当前工具激活，回到"可拖窗"状态） -->
                    <Button x:Name="UndoButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnUndoClicked"
                            ToolTip="撤销 (Ctrl+Z)">
                        <iconPacks:PackIconMaterialDesign Kind="UndoRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="RedoButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnRedoClicked"
                            ToolTip="重做 (Ctrl+Y)">
                        <iconPacks:PackIconMaterialDesign Kind="RedoRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="ClearButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnClearClicked"
                            ToolTip="清空全部标注">
                        <iconPacks:PackIconMaterialDesign Kind="DeleteSweepRound" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="DoneButton"
                            Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnDoneClicked"
                            ToolTip="完成标注（取消当前工具 · Esc）">
                        <iconPacks:PackIconMaterialDesign Kind="CheckRound" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 轻量 LocalToast：复制 / 保存反馈贴近用户操作点，比飘到主窗中央更直接
             默认 Collapsed 时 Row 高度归零，不会影响工具条整体定位 -->
        <Border x:Name="LocalToastBorder"
                Grid.Row="1"
                HorizontalAlignment="Center"
                Margin="0,4,0,0"
                Padding="10,4"
                Background="{DynamicResource ToolbarToastBackground}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.20" Color="Black" />
            </Border.Effect>
            <TextBlock x:Name="LocalToastText"
                       Foreground="{DynamicResource ToolbarForeground}"
                       FontSize="11.5" />
        </Border>
    </Grid>
</Window>
