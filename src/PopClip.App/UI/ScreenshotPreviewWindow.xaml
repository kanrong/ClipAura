<Window x:Class="PopClip.App.UI.ScreenshotPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="截图预览"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <!-- 主窗自身只渲染"截图 + 边框"，工具条已拆成 ScreenshotPreviewToolbarWindow 独立子窗口。
         这样窄高 / 高长截图的主窗宽度严格 = 截图宽度，不会被工具条反推撑宽变形。
         外层 Margin=2 仅给抗锯齿留极小余量；不再给 DropShadow 预留空间。
         相比早期"BlurRadius=4/Depth=1 阴影 + 浅色边框"方案，整体观感更克制，
         与 Snipaste 的纯描边风格一致 -->
    <Grid Margin="2">
        <!-- 主图边框：去掉 DropShadow 立体效果，仅保留一道实线描边。
             颜色固定为深灰蓝 #5A6680，比浅色主题的 ToolbarAccentSoft 明显加深；
             不依赖主题画刷，避免深色 / 彩色主题里边框颜色变浅与桌面分不清。
             Cursor=SizeAll 让用户在主图任意位置都能 DragMove 整窗 -->
        <Border x:Name="Frame"
                BorderBrush="#FF5A6680"
                BorderThickness="2"
                Background="Transparent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Cursor="SizeAll">
            <Grid ClipToBounds="True">
                <!-- Stretch=None 让 Image 控件 DIP = BitmapSource DIP；
                     BitmapSource 用 anchor monitor DPI 创建，保证 DIP × 屏幕 DPI = anchor 物理像素，
                     绘制时不触发任何缩放算法，文字与原截图严格 1:1 -->
                <Image x:Name="PreviewImage"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />
                <!-- 标注层：默认 IsHitTestVisible=False 让点击穿透到主图，让用户能照常拖动整窗；
                     进入标注模式后由 AnnotationCanvasController 改 IsHitTestVisible=True 接管事件 -->
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
