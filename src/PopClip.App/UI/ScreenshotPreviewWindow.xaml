<Window x:Class="PopClip.App.UI.ScreenshotPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="截图预览"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <Window.Resources>
        <Style x:Key="ScreenshotToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ToolbarForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderRoot" Property="Background" Value="{DynamicResource ToolbarAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame"
            BorderBrush="{DynamicResource ToolbarAccent}"
            BorderThickness="1"
            Background="{DynamicResource ToolbarToastBackground}"
            Cursor="SizeAll">
        <Grid ClipToBounds="True">
            <Image x:Name="PreviewImage"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Border x:Name="ToolbarBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="8"
                    Padding="6,4"
                    Background="{DynamicResource ToolbarToastBackground}"
                    BorderBrush="{DynamicResource ToolbarBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.24" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnCopyClicked"
                            ToolTip="复制图片到剪贴板">
                        <iconPacks:PackIconMaterialDesign Kind="ContentCopyRound" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnSaveClicked"
                            ToolTip="保存图片为 PNG">
                        <iconPacks:PackIconMaterialDesign Kind="SaveAltRound" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnOcrClicked"
                            ToolTip="OCR 识别当前截图">
                        <iconPacks:PackIconMaterialDesign Kind="DocumentScannerRound" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource ScreenshotToolButtonStyle}"
                            Click="OnCloseClicked"
                            ToolTip="关闭 (Esc)">
                        <iconPacks:PackIconMaterialDesign Kind="CloseRound" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="ToastBorder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,10"
                    Padding="10,4"
                    Background="{DynamicResource ToolbarToastBackground}"
                    BorderBrush="{DynamicResource ToolbarBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.20" Color="Black" />
                </Border.Effect>
                <TextBlock x:Name="ToastText"
                           Foreground="{DynamicResource ToolbarForeground}"
                           FontSize="11.5" />
            </Border>
        </Grid>
    </Border>
</Window>
