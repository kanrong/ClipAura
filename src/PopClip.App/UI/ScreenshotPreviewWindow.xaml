<Window x:Class="PopClip.App.UI.ScreenshotPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Title="截图预览"
        FontFamily="{DynamicResource ToolbarFontFamily}">

    <!-- 主窗自身只渲染"截图 + 阴影边框"，工具条已拆成 ScreenshotPreviewToolbarWindow 独立子窗口。
         这样窄高 / 高长截图的主窗宽度严格 = 截图宽度，不会被工具条反推撑宽变形。
         外层 Margin=4 给 DropShadow 留绘制空间；窗口总 DIP = 4*2 + Frame DIP。
         Margin 之前用 14 是想给"BlurRadius=10/ShadowDepth=2"的阴影留足够余量，但实际把
         "Frame 视觉上边"与"Window 边"拉开 14 DIP，用户拖动窗口时根本贴不到屏幕边，
         也没法把窗口部分推到屏幕外（看到的总是 Window 边 + 14 DIP 之后的 Frame）。
         现在压到 4 DIP + 极轻阴影（BlurRadius=4/Depth=1），Frame 几乎贴 Window 边 -->
    <Grid Margin="4">
        <!-- 主图边框：BorderBrush / 阴影强度与 OcrResultWindow 严格对齐，
             两个窗口外观成一套设计语言。Cursor=SizeAll 让用户在主图任意位置都能 DragMove 整窗 -->
        <Border x:Name="Frame"
                BorderBrush="{DynamicResource ToolbarAccentSoft}"
                BorderThickness="2"
                Background="Transparent"
                HorizontalAlignment="Center"
                Cursor="SizeAll">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.20" Color="Black" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <!-- Stretch=None 让 Image 控件 DIP = BitmapSource DIP；
                     BitmapSource 用 anchor monitor DPI 创建，保证 DIP × 屏幕 DPI = anchor 物理像素，
                     绘制时不触发任何缩放算法，文字与原截图严格 1:1 -->
                <Image x:Name="PreviewImage"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
